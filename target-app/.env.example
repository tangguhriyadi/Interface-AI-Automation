# Required — no defaults, loadConfig() throws if any of these are missing or
# empty. Set them yourself in your own .env; never commit real values.
TARGET_APP_USERNAME=<set-a-username>
TARGET_APP_PASSWORD=<set-a-password>
SESSION_SECRET=<set-a-random-session-secret>

# Optional — fall back to the defaults below if unset.

# Port the server listens on
PORT=4000

# Tenant label overlay: "default" or "beta". Unknown/unset falls back to "default".
TENANT=default

# Number of authenticated requests a session survives before being treated as
# expired (forces re-login mid-flow). 0 or unset = never expire.
EXPIRE_SESSION_AFTER_REQUESTS=0

# Milliseconds the "slow load" member (10004) delays its response. Defaults to
# 6000 to match the take-home spec; override low in tests.
SLOW_LOAD_MS=6000
