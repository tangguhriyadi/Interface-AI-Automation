# Base URL of the running target-app instance. Start it separately —
# see /target-app/README.md — this project never spawns it.
TARGET_APP_BASE_URL=http://localhost:4000

# Test credentials — must match the values you put in target-app's own .env.
# /automation never reads target-app's .env file; type the same values into both.
TARGET_APP_USERNAME=<same-username-as-target-app>
TARGET_APP_PASSWORD=<same-password-as-target-app>

# Optional, and deliberately not "always on". Set this ONLY right before running
# the beta-tenant integration test: stop target-app, restart it with TENANT=beta,
# then set this to the SAME URL the tenant overlay declares
# (capabilities/fake-credit-union-console.beta.tenant-overlay.json's baseUrl —
# normally the same host/port as TARGET_APP_BASE_URL above, since one target-app
# process serves one tenant at a time; you switch tenants by restarting it, not
# by running two instances). The allowlist checks against the overlay's declared
# baseUrl, so this must match it or the test fails with a clear allowlist error.
# The test is skipped whenever this is unset — leave it unset for normal runs
# against the default tenant, or it will fail instead of skipping.
# TARGET_APP_BETA_BASE_URL=http://localhost:4000

# Required only for the discovery loop (test:integration's discovery scenarios,
# and any future `discover` CLI run). Never logged, never written to evidence —
# see automation/discovery/model.ts. Get a key at https://console.anthropic.com/.
ANTHROPIC_API_KEY=<your-own-anthropic-api-key>

# Model discovery drives the tool-use loop with. Optional — defaults to
# claude-sonnet-5 when unset.
# DISCOVERY_MODEL=claude-sonnet-5
